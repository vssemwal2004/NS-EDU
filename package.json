{
  "name": "nsedu",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "predev": "npm run mongo:start",
    "dev": "concurrently -n web,api -c yellow,green \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "predev:backend": "npm run mongo:start",
    "dev:backend": "npm run dev --workspace backend",
    "mongo:start": "node backend/scripts/local-mongo.mjs start",
    "mongo:stop": "node backend/scripts/local-mongo.mjs stop",
    "mongo:status": "node backend/scripts/local-mongo.mjs status",
    "build": "npm run build --workspace frontend",
    "test:backend": "npm test --workspace backend",
    "seed": "npm run seed --workspace backend",
    "lint": "npm run lint --workspace frontend",
    "test:frontend": "npm test --workspace frontend"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": { "concurrently": "^9.2.1" }
}
