PORT=4100
# Required: every public page, student login and the admin console read MongoDB through this API.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DATABASE=nsedu

# Authentication
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64-random-hex-characters>
# Initial admin created by `npm run seed` (use --reset-admin to reset the password).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=Gyaan Vidhya Admin
# How student sign-in codes are delivered:
#   smtp    = email the code through the SMTP server below (required in production)
#   console = print codes to the server log and return them to the dev UI (development only)
# When unset: smtp if SMTP_HOST is set, otherwise console.
OTP_DELIVERY=smtp

# Outgoing mail for sign-in codes. Port 465 uses implicit TLS; any other port (587) must offer STARTTLS.
# SMTP_FROM may be a bare address (sent as "Gyaan Vidhya <address>") or a full "Name <address>".
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=<smtp-password-or-app-password>
SMTP_FROM=no-reply@example.com

# Mobile-number sign-in. Leave unset to hide it (no SMS provider is integrated yet; GET /api/auth/config
# then lists only "email"). "console" prints SMS codes to the log for local testing and is refused in
# production unless ALLOW_CONSOLE_OTP=true.
SMS_PROVIDER=
# Express "trust proxy" setting used for client IPs in rate limits (default: loopback).
TRUST_PROXY=loopback
# Interface the API binds to (default 127.0.0.1; use 0.0.0.0 inside a container).
HOST=127.0.0.1

# Cloudinary image storage (media library, university logos, `npm run images:migrate`).
# Copy "API environment variable" from the Cloudinary console. Never commit the real value.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Root folder for all uploads (default gyaan-vidhya).
CLOUDINARY_FOLDER=gyaan-vidhya

# University data scraper (`npm run scrape`, see src/scraper/README.md). All optional.
# Public site URL; the crawler identifies itself as "GyaanVidhyaBot/1.0 (+<SITE_URL>/bot)".
SITE_URL=
# Full User-Agent override. Keep the GyaanVidhyaBot token and a page explaining the bot and opt-out.
SCRAPER_USER_AGENT=
# Sites crawled in parallel by one worker process (default 4).
SCRAPER_CONCURRENCY=4
# Minimum gap between requests to one site in ms (default 3000; a larger robots.txt Crawl-delay wins).
SCRAPER_HOST_DELAY_MS=3000
# Pages fetched per institution, home page included (default 8).
SCRAPER_MAX_PAGES=8
# Per-request timeout in ms (default 15000).
SCRAPER_TIMEOUT_MS=15000
