PORT=4100
# Required for student login, the admin console and live catalogue data.
# Without it the public pages fall back to bundled seed data.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DATABASE=nsedu

# Authentication
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64-random-hex-characters>
# Initial admin created by `npm run seed` (use --reset-admin to reset the password).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=NSEDU Admin
# console = print one-time codes to the server log (development only).
OTP_DELIVERY=console
# Express "trust proxy" setting used for client IPs in rate limits (default: loopback).
TRUST_PROXY=loopback
